{
  "name": "studyflow",
  "version": "0.1.0",
  "private": true,
  "description": "StudyFlow - Student Planner (React + Express + MongoDB)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client && npm install --prefix e2e",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test": "npm test --prefix server",
    "test:e2e": "npm test --prefix e2e --",
    "lint": "npm run lint --prefix client",
    "build": "npm run build --prefix client",
    "check:integrity": "npm run check:integrity --prefix server --"
  }
}
