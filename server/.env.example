# Copy this file to ".env" (same folder) and replace the placeholders.
# NEVER commit .env or share its contents.

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Main database used by the running app (database name: studyflow)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/studyflow?retryWrites=true&w=majority

# Separate database used ONLY by automated tests (database name must be studyflow_test)
MONGODB_TEST_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/studyflow_test?retryWrites=true&w=majority
